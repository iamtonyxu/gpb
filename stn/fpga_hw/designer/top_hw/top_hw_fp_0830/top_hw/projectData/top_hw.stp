PROCEDURE POLL_DEVICE_READY USES GV,DO_EXIT;
    PASS = 0;
    INTEGER ILOOP_1;
    FOR ILOOP_1 = 10000 -1 TO 0 STEP -1;
        IRSTOP IRPAUSE;
        DRSTOP DRPAUSE;
