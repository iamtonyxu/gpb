        DRSCAN 128, $00000000000000000000000000000000, CAPTURE KEYLO_RESULT[127..0];
        IF ( ! (KEYLO_RESULT[127]==0) ) THEN GOTO KEYLO_POLL;
        IPOLL = 0;
        PASS = 1;
